# dmenu 
super + d
  j4-dmenu-desktop --dmenu="dmenu -nb '#32363e' -nf '#abb2bf' -sb '#e06c75' -sf '#233c34'"

super + shift +d 
  dmenu_run -nb '#32363e' -nf '#abb2bf' -sb '#e06c75' -sf '#233c34'
  
# apps
super + t
  kitty

super + Return
  xterm

super + w
  firefox

super + e
  thunar

# menu
## main menu
super + i
  $HOME/.config/dmenu/scripts/optionsMenu.sh

## powermenu
ctrl + alt + Delete
  $HOME/.config/dmenu/scripts/powermenu.sh

# BSPWM
## toDesktop/monitor
super + {1-9}
  bspc desktop -f '^{1-9}'

super + shift + {1-9}
  bspc node -d '^{1-9}'

## windows
super + {Left,Down,Up,Right}
    bspc node -f {west,south,north,east}

super + shift + {Left,Down,Up,Right}
    bspc node -s {west,south,north,east}

super + b
    bspc node focused -t ~floating

super +  f
    bspc node focused -t ~fullscreen

## wm
super + ctrl + alt +r
  $HOME/.config/sxhkd/scripts/restart.sh

## screenshot
### area screenshot
super + shift + s
  flameshot gui

### fullscreen screenshot
super + Print
  flameshot full

## apps
### close
super + q
  bspc node -c
### kill
super + shift + q
  bspc node -k

### clipboard
super + v
  clipmenu -nb '#32363e' -nf '#abb2bf' -sb '#e06c75' -sf '#233c34'

### deamons
#### brightnessctl
XF86MonBrightnessUp
  brightnessctl set 10%+

XF86MonBrightnessDown
  brightnessctl set 10%-

#### volume
XF86AudioRaiseVolume
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+

XF86AudioLowerVolume
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

XF86AudioMute
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
