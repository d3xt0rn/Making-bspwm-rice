# dmenu 
super + d
  j4-dmenu-desktop

super + shift +d 
  dmenu_run

# apps
super + t
  kitty

super + Return
  xterm

super + w
  firefox

super + e
  thunar

# menu
## main menu
super + i
  $HOME/.config/dmenu/scripts/optionsMenu.sh

## powermenu
ctrl + alt + Delete
  $HOME/.config/dmenu/scripts/powermenu.sh

# BSPWM
## toDesktop/monitor
super + {1-9}
  bspc desktop -f '^{1-9}'

super + shift + {1-9}
  bspc node -d '^{1-9}'

## windows
super + {Left,Down,Up,Right}
    bspc node -f {west,south,north,east}

super + shift + {Left,Down,Up,Right}
    bspc node -s {west,south,north,east}

super + b
    bspc node focused -t ~floating

## wm
super + ctrl + alt +r
  $HOME/.config/sxhkd/scripts/restart.sh

## screenshot
### area screenshot
super + shift + s
  spectacle

### fullscreen screenshot
#super + Print
#  spectacle -b

## apps
### close
super + q
  bspc node -c
### kill
super + shift + q
  bspc node -k

### clipboard
super + v
  clipmenu
