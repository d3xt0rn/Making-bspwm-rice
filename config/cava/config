## Configuration file for CAVA
# Faster response + smooth fadeout

[general]
live-config = 1
framerate = 512
autosens = 1
sensitivity = 100
bars = 0
bar_width = 2
bar_spacing = 1
center_align = 1
max_height = 100
lower_cutoff_freq = 1
higher_cutoff_freq = 22000
sleep_timer = 0

[input]
method = pipewire
source = auto
sample_rate = 48000
sample_bits = 16
channels = 2
autoconnect = 1
active = 1
remix = 1
virtual = 1

[output]
method = noncurses
orientation = bottom
channels = stereo
reverse = 0
raw_target = /dev/stdout
data_format = binary
bit_format = 8bit
xaxis = none
synchronized_sync = 1
show_idle_bar_heads = 1
waveform = 0

[color]
foreground = '#ffffff'
gradient = 1

gradient_color_1 = '#282c34'
gradient_color_2 = '#32363e'
gradient_color_3 = '#e06c75'

[smoothing]
noise_reduction = 0
# уменьшаем шум, чтобы реакция была острее
# fadeout можно задавать через zdelay

[eq]
1 = 1
2 = 1
3 = 1
4 = 1
5 = 1

[advanced]
zdelay = 0       # мгновенная реакция
fade_speed = 0  # фейдоут 25 мс
